# API base (no /v1). Inlined at build time.
NEXT_PUBLIC_BACKEND_API=http://localhost:3001

# The site's public URL: canonical links, sitemaps, share images and robots.txt use it. Inlined at build time.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: the site's X/Twitter handle for share cards, e.g. @projectforum
# NEXT_PUBLIC_TWITTER_HANDLE=""

# Optional: Search Console and Bing Webmaster Tools verification codes (the content="" value of their meta tag)
# GOOGLE_SITE_VERIFICATION=""
# BING_SITE_VERIFICATION=""

# Optional: IndexNow key, served at /indexnow-key.txt. Must match the API's INDEXNOW_KEY.
# INDEXNOW_KEY=""
