# API base (no /v1). Inlined at build time.
NEXT_PUBLIC_BACKEND_API=http://localhost:3001

# The site's public URL: canonical links, sitemaps, share images and robots.txt use it. Inlined at build time.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: the site's X/Twitter handle for share cards, e.g. @projectforum
# NEXT_PUBLIC_TWITTER_HANDLE=""

# Optional: Search Console and Bing Webmaster Tools verification codes (the content="" value of their meta tag)
# GOOGLE_SITE_VERIFICATION=""
# BING_SITE_VERIFICATION=""

# Optional: IndexNow key, served at /indexnow-key.txt. Must match the API's INDEXNOW_KEY.
# INDEXNOW_KEY=""

# Where legal requests, takedowns and appeals go; shown on the policy pages. Inlined at build time.
NEXT_PUBLIC_LEGAL_EMAIL=legal@forum.oskeylabs.com

# Optional: PostHog project key (EU cloud) for page views and shares. Without it nothing is sent. Inlined at build time.
# NEXT_PUBLIC_POSTHOG_KEY=""
# POSTHOG_HOST="https://eu.i.posthog.com"

# "true" while the site is in private testing: robots.txt blocks everything and every page is sent noindex
# PRIVATE_SITE="true"
